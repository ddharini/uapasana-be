{
  "name": "upasana-be",
  "version": "1.0.0",
  "description": "Upasana backend \u2014 Express, Prisma and Better Auth on the madmax SaaS chassis",
  "main": "index.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon src/index.ts",
    "build": "tsc",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "start:dev": "cross-env NODE_ENV=development node dist/index.js",
    "worker": "cross-env NODE_ENV=development nodemon --config nodemon.worker.json",
    "dev:all": "concurrently -n api,worker -c cyan,magenta --kill-others \"pnpm dev\" \"pnpm worker\"",
    "worker:start": "cross-env NODE_ENV=production node dist/worker/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "db:push": "prisma db push && ts-node scripts/ensure-partial-indexes.ts",
    "seed:registrations": "ts-node scripts/seed-registrations.ts",
    "seed:schedule": "ts-node scripts/seed-schedule.ts",
    "seed:accommodation": "ts-node scripts/seed-accommodation.ts",
    "grant-role": "ts-node scripts/grant-role.ts",
    "wa:test": "ts-node scripts/send-test-whatsapp.ts"
  },
  "keywords": [
    "express",
    "typescript",
    "prisma"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.12.4",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@better-auth/prisma-adapter": "^1.6.25",
    "@google/genai": "^2.22.0",
    "@prisma/client": "^6.17.0",
    "better-auth": "^1.6.25",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv-flow": "^4.1.0",
    "express": "^5.1.0",
    "prisma": "^6.17.0",
    "resend": "^6.22.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
