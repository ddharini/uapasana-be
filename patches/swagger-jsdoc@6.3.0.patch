+// yaml 2 dropped Document#anchors and cstNode (swagger-jsdoc was written
+// against the 2.0.0-1 pre-release); list a document's anchors by walking it.
+const anchorNames = (doc) => {
+  const names = [];
+  YAML.visit(doc, {
+    Node(_, node) {
+      if (node.anchor) names.push(node.anchor);
+    },
+  });
+  return names;
+};
