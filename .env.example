# Server
#
# This file is the template for THREE real files, all gitignored:
#   .env              loaded always (dotenv-flow); the base/shared config
#   .env.development   layered on top of .env when NODE_ENV=development
#   .env.production    layered on top of .env when NODE_ENV=production
# `pnpm dev`/`start:dev` set NODE_ENV=development and `pnpm start` sets
# NODE_ENV=production (via cross-env, so it works the same on Windows). A key only
# needs to exist in the env-specific file if its value actually differs there.
PORT=5000
NODE_ENV=development

# URL of your frontend application (used for CORS)
FRONTEND_URL=http://localhost:5173

# URL of the admin panel, used for CORS + Better Auth trusted origins
ADMIN_URL=http://localhost:5180

# MongoDB connection string
# Note: MongoDB reserves the database names `local`, `admin` and `config` —
# writes against them fail because they cannot join a transaction.
DATABASE_URL="mongodb://localhost:27017/upasana"

# ---------------------------------------------------------------------------
# Branding
# ---------------------------------------------------------------------------

# Your product's name and marketing site. Used in transactional emails
# (src/lib/email-templates.ts) and the Swagger page title. Set these first —
# the defaults say "Acme".
BRAND_NAME=Upasana
SITE_URL=http://localhost:5173

# The logo shown in email headers. Must be a PNG on a public URL — Gmail strips
# `data:` sources and no major mail client renders SVG. Defaults to
# <SITE_URL>/email/mark.png.
BRAND_MARK_URL=

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------

# Better Auth — generate the secret with `openssl rand -base64 32`.
# BETTER_AUTH_URL is this server's own origin; Better Auth serves its routes under
# /api/auth beneath it and builds OAuth callback URLs from it.
BETTER_AUTH_SECRET=replace-me
BETTER_AUTH_URL=http://localhost:5000

# Google OAuth — from Google Cloud Console → APIs & Services → Credentials.
# Authorised redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
# Leave unset to run with email/password sign-in only.
GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me

# ---------------------------------------------------------------------------
# Email (Resend)
# ---------------------------------------------------------------------------

# Resend — dashboard → API Keys. Sends the password-reset link and the welcome
# email. Without this set, password reset fails and signup still succeeds (the
# welcome email is a logged miss, never a blocked account — see src/lib/auth.ts).
RESEND_API_KEY=replace-me

# Must be on a domain verified in the Resend dashboard, or sending fails at
# request time. Until a domain is verified, Resend's own onboarding@resend.dev
# works but only delivers to the email address the Resend account itself was
# signed up with — fine for local testing, not for real users.
RESEND_FROM_EMAIL=Upasana <onboarding@resend.dev>

# ---------------------------------------------------------------------------
# WhatsApp (Meta Cloud API)
# ---------------------------------------------------------------------------

# Sends the registration form's verification codes and team invites on
# WhatsApp, straight through Meta (no BSP). Without WA_ACCESS_TOKEN and
# WA_PHONE_NUMBER_ID (or while the token is replace-me) mobile invites still
# work — the admin gets the link and shares it themselves — and verification
# codes are printed to the server log in development; production refuses to
# send them. setup.md → "WhatsApp (Meta Cloud API)" has the template wording.

# The Graph API version in the URL. Meta's API Setup page shows the current one.
WA_GRAPH_VERSION=v25.0

# App → WhatsApp → API Setup → "Phone number ID" (not the phone number).
#   Production +91 93271 03949 (portfolio 1432375662355302): 1329621763576319
#   (+91 99131 77084 and the +1 555 test number belong to the first, locked
#   portfolio — see ../whatsapp-business.md — and no longer work with this token.)
WA_PHONE_NUMBER_ID=

# The WhatsApp Business Account that owns that number. Not read by the code
# yet; kept with the rest so the IDs travel together.
#   Production 2298684017631633
WA_WABA_ID=

# SECRET. App → WhatsApp → API Setup gives a temporary token that expires in
# about 24 hours; replace it with a System User's permanent token once 2FA is
# on. An expired token shows in the log as "WA_ACCESS_TOKEN is expired".
WA_ACCESS_TOKEN=replace-me

# SECRET. App settings → Basic → App secret (of app 1156648827315666). Checks that
# webhook calls really come from Meta; without it /api/webhooks/whatsapp stores nothing.
WA_APP_SECRET=
# Any long random string (openssl rand -hex 24). Meta sends it back once, when the
# callback URL is saved, and the server must recognise it.
WA_WEBHOOK_VERIFY_TOKEN=

# The language a message goes in when the reader's is unknown (en | gu).
WA_DEFAULT_LANG=en
# Meta's code for each language, as the templates were created. "English" is
# en; pick en_US here only if the templates were made in "English (US)".
WA_LANG_CODE_EN=en
WA_LANG_CODE_GU=gu

# Template names as created in WhatsApp Manager → Message templates.
WA_TEMPLATE_OTP=anoopam_otp
WA_TEMPLATE_INVITE=team_invite
WA_TEMPLATE_ROOM_DETAILS=room_details
# Sent to the contact once a registration is saved (Utility, en + gu):
# {{1}} first name, {{2}} registration code, {{3}} people, {{4}} stay + the PDF
# link (signed with BETTER_AUTH_SECRET, on BETTER_AUTH_URL).
WA_TEMPLATE_REGISTRATION=registration_confirmation
# The Utility template with a slot for your own words, used by Send messages
# (/admin/messages) as "Your own text": {{1}} their first name, {{2}} the text.
WA_TEMPLATE_ANNOUNCEMENT=anoopam_update

# Different people Meta lets this number message per 24 hours (WhatsApp
# Manager → Messaging limits): 250 until the business is verified, then 2000+.
# Meta doesn't report it through the API, so update it by hand; Send messages
# only uses it to warn before a send that would go past it.
WA_DAILY_LIMIT=250

# Most verification codes sent per hour across all numbers — a cap on what a
# script hammering the public registration form can spend. Default 500.
OTP_MAX_PER_HOUR=500

# ---------------------------------------------------------------------------
# AI
# ---------------------------------------------------------------------------

# Anthropic — powers src/lib/ai/claude.ts. Every call is metered into the
# `usage_event` collection, so you can see what a user costs before the invoice
# does. Optional: the app boots without it.
ANTHROPIC_API_KEY=

# The model behind the admins' Assistant (/admin/assistant). Default
# claude-haiku-5-5, the cheapest (~0.2 US cents a question). Any current Claude
# model works: claude-sonnet-5-5 (~3–4¢), claude-opus-5-5 (~5–8¢). Restart the
# server after changing it. Optional.
ASSISTANT_MODEL=

# true: the Assistant counts the dummy registrations by default, for testing
# before real registrations come in (its screen shows a banner). Leave empty
# for real use. Optional.
ASSISTANT_INCLUDE_DUMMY=

# Google AI Studio — powers src/lib/ai/gemini.ts, the cheap bulk-call client.
# Optional.
GOOGLE_API_KEY=

# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------

# Set to 1 to log every Prisma query. Off by default — the worker polls the job
# collection every five seconds, and unconditional query logging buries every
# real line under hundreds of aggregate pipelines.
PRISMA_LOG_QUERIES=0